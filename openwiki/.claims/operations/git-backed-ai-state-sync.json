    {
      "id": "claim_a2f92e3b07734514a48d782d33b3522f",
      "statement": "reconcile_committed_state returns immediately in local-only mode or without a configured remote, otherwise re-pins the origin refspecs to the ai-state branch before any fetch and treats a refspec failure as a reason to skip remote reconciliation while keeping local commits.",
