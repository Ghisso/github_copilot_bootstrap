    {
      "id": "claim_de542fb80b8c4b3ba24e1410c4c9458c",
      "statement": ".claude/ in a full-install consumer is a self-contained Git repository on the branch ai-state tracking both installed bootstrap files and mutable AI state, and the outer repository ignores it entirely so its commits are visible only through git -C .claude.",
      "evidence": [
        {
          "resource": "repo://.gitignore#L1-L6",
          "version": "repo-lines-v1:sha256:ac6f1e07a2b981f381714cfa151a85eddf710553d96606360ef36e726c205a13:"
        },
        {
