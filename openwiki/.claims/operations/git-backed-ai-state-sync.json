    {
      "id": "claim_d0c8e95388354bca9444c2fa94c12532",
      "statement": "configure_outer_hooks_path sets the outer repository's core.hooksPath to the fixed literal .claude/hooks/git-hooks once that directory exists, leaves a matching value alone, overwrites a different value with a warning naming the old one, and only warns on failure; it is the one write state-sync.sh makes outside .claude/.",
      "evidence": [
