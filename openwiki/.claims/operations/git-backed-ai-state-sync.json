    {
      "id": "claim_9efd658aef104b12b5c3b06a32abf461",
      "statement": "pull records local nested state first, then reconciles committed state with origin/ai-state when a remote is configured and not in local-only mode, and only after a successful reconcile restores root adapters and checkpoints, so state that failed to reconcile never overwrites adapters.",
