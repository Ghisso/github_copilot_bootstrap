    {
      "id": "claim_39bca007e28a4304a19a02f7626846ba",
      "statement": "restore-root-adapters.sh copies the installer-owned root adapters carried in .claude/bootstrap-root/ back to their real locations outside .claude/, reading the list from .claude/bootstrap-ownership.env, and exits 0 silently when either the mirror or the manifest is absent.",
