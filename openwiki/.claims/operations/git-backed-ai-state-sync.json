        }
      ]
    },
    {
      "id": "claim_03bbd220263d4ac2b7f9ed0296c0c624",
      "statement": "pull records local nested state first, reconciles committed state with origin/ai-state when a remote is configured and not in local-only mode, and only after a successful reconcile restores root adapters and checkpoints.",
      "evidence": [
        {
          "resource": "repo://shared/hooks/scripts/state-sync.sh#L611-L646",
          "version": "repo-lines-v1:sha256:abe30fb2601e1e4cfe3cd9a1b3ec431cfc80d136a64531637ebc128a498af732:"
        }
      ]
    },
    {
      "id": "claim_fbec7137d5e9400e8ef82fb4f25e1443",
      "statement": "publish sends only already committed state: a dirty nested worktree makes it warn and preserve the uncheckpointed state, a clean one reconciles then pushes, and repeated clean publication is a no-op.",
