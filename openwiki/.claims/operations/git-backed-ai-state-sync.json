        }
      ]
    },
    {
      "id": "claim_3bd871ff356c4e4494d28c724444a60a",
      "statement": "Every mutating state-sync.sh command is dispatched with a trailing warn-and-continue and the script always exits 0, so a missing remote, offline network, or rebase conflict can never block a session or fail an outer commit; warnings go to stderr and .claude/session_logs/hooks-errors.log.",
      "evidence": [
        {
          "resource": "repo://shared/hooks/scripts/state-sync.sh#L51-L63",
          "version": "repo-lines-v1:sha256:33cd07e2ab96c21b9eac00b95fca76520a8b331cb2ce0cefead0f36ae9bd7a07:"
