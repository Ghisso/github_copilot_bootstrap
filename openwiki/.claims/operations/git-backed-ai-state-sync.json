        }
      ]
    },
    {
      "id": "claim_f109b479bf784688ab94dadcab98ee16",
      "statement": "checkpoint initializes the nested repository if needed (restoring root adapters on that path) and commits local AI state with no remote operation; push is checkpoint followed by publish and skips publication when the checkpoint fails.",
      "evidence": [
        {
          "resource": "repo://shared/hooks/scripts/state-sync.sh#L385-L392",
          "version": "repo-lines-v1:sha256:4f095bf5225db0d3bf0d48cdeb8892a8deade950e59ca030a98b32c73f226f9a:"
