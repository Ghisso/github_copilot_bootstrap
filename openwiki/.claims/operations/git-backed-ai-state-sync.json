  "claims": [
    {
      "id": "claim_3ba2a5c8392843328dfe722f054568a8",
      "statement": ".claude/ in a consumer is a self-contained Git repository with its own .git directory on the branch ai-state, tracking both installed bootstrap files and mutable AI state (MEMORY.md, plans, explorations, session logs, quality reports), and the outer repository ignores it entirely so its commits are visible only through git -C .claude.",
      "evidence": [
        {
          "resource": "repo://docs/architecture.md#L509-L513",
          "version": "repo-lines-v1:sha256:ef1e46ac49b4cb3dfc49dab4c57308b123f06a08acf128b3276378c2ebbff897:"
        },
        {
          "resource": "repo://shared/hooks/scripts/state-sync.sh#L1-L48",
          "version": "repo-lines-v1:sha256:83211c3f76971cf6421568f954564b4a23e988bfd84c66ff635b6def3164013e:"
        }
      ]
    },
    {
      "id": "claim_fa0397ae2f0b40878d62fdb0583fe9c3",
      "statement": "state-sync.sh is pure Bash rendered into both .claude/hooks/scripts/ and .devcontainer/ so a fresh clone can bootstrap .claude before it exists; it resolves the repository root from its own location or AI_STATE_REPO_ROOT and honors --local-only or AI_STATE_LOCAL_ONLY=1 to skip all remote interaction.",
      "evidence": [
        {
          "resource": "repo://shared/hooks/scripts/state-sync.sh#L1-L48",
          "version": "repo-lines-v1:sha256:83211c3f76971cf6421568f954564b4a23e988bfd84c66ff635b6def3164013e:"
