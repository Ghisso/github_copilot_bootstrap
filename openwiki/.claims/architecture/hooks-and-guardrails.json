          "resource": "repo://shared/hooks/scripts/run-hook.sh",
          "version": "repo-file-v1:sha256:fbf6d4ed20fa552013a4a7a85fc9a2cb2446eb512436ea297599968a65e435bc"
        }
      ]
    },
