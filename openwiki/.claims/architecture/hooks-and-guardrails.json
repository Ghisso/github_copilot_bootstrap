  "claims": [
    {
      "id": "claim_734cd1c8e47447bea16847dc913dff2a",
      "statement": "run-hook.sh is the shared dispatcher for Copilot, Claude Code, and Codex hooks: it resolves the repository root from its own location, then GITHUB_WORKSPACE, WORKSPACE_FOLDER, VSCODE_CWD, or PWD, then git rev-parse, exits 2 on a missing script name, and only warns and exits 0 when the named script file is missing.",
      "evidence": [
        {
          "resource": "repo://shared/hooks/scripts/run-hook.sh",
          "version": "repo-file-v1:sha256:fbf6d4ed20fa552013a4a7a85fc9a2cb2446eb512436ea297599968a65e435bc"
        }
      ]
    },
    {
      "id": "claim_c0c6f425fbec468db97b519c82a5b5c6",
      "statement": "Google Antigravity is the exception to run-hook.sh dispatch: its generated .agents/hooks.json wires a single '*' PreToolUse matcher to antigravity-pretool.py, a Python bridge that normalizes the payload and invokes the canonical guards, and it deliberately has no lifecycle hooks.",
