      "statement": "git-protection.sh denies git reset --hard, force pushes (-f, --force, --force-with-lease), git push --mirror, git checkout --, git restore --source, git clean with both f and d flags, and deleting main or master, tokenizing each git clause up to the next unquoted shell operator and lowercasing tokens.",
