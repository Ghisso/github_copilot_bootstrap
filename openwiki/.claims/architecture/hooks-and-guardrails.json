    {
      "id": "claim_e1241c733562424da1a1e99b7e23dfe8",
      "statement": "pretool-bash-guard.sh is the ordered safety lane for Bash tool calls: it runs protect-files.sh, git-protection.sh, enforce-branch-state.sh, enforce-commit-gate.sh, and enforce-pr-gate.sh in sequence with the same payload, exits on the first deny or ask decision, and fails closed if a guard exits non-zero or prints malformed output.",
      "evidence": [
        {
          "resource": "repo://shared/hooks/scripts/pretool-bash-guard.sh#L6-L32",
          "version": "repo-lines-v1:sha256:e25f9177b72c1e54e82c44bc19c7cc2b9e9cd843501472e697d7832549f35de3:"
        }
