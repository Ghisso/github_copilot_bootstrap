{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "./scripts/session-log.sh",
        "cwd": ".github/hooks",
        "timeoutSec": 10
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "./scripts/session-log.sh",
        "cwd": ".github/hooks",
        "timeoutSec": 10
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "./scripts/protect-files.sh",
        "cwd": ".github/hooks",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "./scripts/git-protection.sh",
        "cwd": ".github/hooks",
        "timeoutSec": 10
      }
    ],
    "errorOccurred": [
      {
        "type": "command",
        "bash": "./scripts/error-log.sh",
        "cwd": ".github/hooks",
        "timeoutSec": 10
      }
    ]
  }
}
