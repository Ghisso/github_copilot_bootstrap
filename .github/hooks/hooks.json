{
  "version": 1,
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": ".github/hooks/scripts/session-log.sh",
        "cwd": ".",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": ".github/hooks/scripts/session-log.sh",
        "cwd": ".",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": ".github/hooks/scripts/protect-files.sh",
        "cwd": ".",
        "timeout": 10
      },
      {
        "type": "command",
        "command": ".github/hooks/scripts/git-protection.sh",
        "cwd": ".",
        "timeout": 10
      }
    ]
  }
}
