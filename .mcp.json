{
  "mcpServers": {
    "semble": {
      "command": "uvx",
      "args": [
        "--from",
        "semble[mcp]",
        "semble"
      ]
    },
    "context-mode": {
      "command": "context-mode"
    },
    "openwiki": {
      "command": "openwiki",
      "args": [
        "mcp",
        "--host",
        "claude"
      ]
    }
  }
}
