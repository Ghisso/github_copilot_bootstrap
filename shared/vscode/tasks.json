{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "AI state: pull",
      "type": "shell",
      "command": ".claude/hooks/scripts/run-hook.sh",
      "args": ["state-sync.sh", "pull"],
      "options": { "cwd": "${workspaceFolder}" },
      "runOptions": { "runOn": "folderOpen" },
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "showReuseMessage": false,
        "close": true
      },
      "problemMatcher": []
    },
    {
      "label": "AI state: push",
      "type": "shell",
      "command": ".claude/hooks/scripts/run-hook.sh",
      "args": ["state-sync.sh", "push"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "showReuseMessage": false
      },
      "problemMatcher": []
    }
  ]
}
