{
  "name": "Multi-Agent GPU Sandbox",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "runArgs": [
    "--gpus",
    "all",
    "--add-host=host.docker.internal:host-gateway",
    "--cap-add=SYS_ADMIN",
    "--security-opt=seccomp=unconfined"
  ],
  "mounts": [
    "source=${localEnv:HOME}/.cache/huggingface,target=/home/vscode/.cache/huggingface,type=bind,consistency=cached"
  ],
  "containerEnv": {
    "HF_XET_HIGH_PERFORMANCE": "1",
    "UV_CACHE_DIR": "/home/vscode/.cache/uv",
    "UV_LINK_MODE": "copy",
    "UV_PROJECT_ENVIRONMENT": "/home/vscode/.venv",
    "HF_TOKEN": "${localEnv:HF_TOKEN}",
    "HUGGING_FACE_HUB_TOKEN": "${localEnv:HUGGING_FACE_HUB_TOKEN}"
  },
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/home/vscode/.venv/bin/python"
      }
    }
  },
  "postCreateCommand": "if command -v uv >/dev/null 2>&1 && [ -f pyproject.toml ]; then mkdir -p /home/vscode/.venv && uv sync; fi",
  "postStartCommand": "bash .devcontainer/post-start.sh"
}
